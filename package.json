{
  "name": "paint-mac",
  "productName": "Paint.mac",
  "version": "1.0.4",
  "description": "A fast, native-feeling Paint.NET-style raster image editor for macOS.",
  "main": "src/main/main.js",
  "author": {
    "name": "Al Roland",
    "url": "https://www.alroland.com/paint.mac"
  },
  "license": "0BSD",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder",
    "pack": "electron-builder --dir",
    "test": "node scripts/check-commands.mjs && node scripts/check-quit.mjs && electron . --dev --selftest --exit-after-tests",
    "icon": "node scripts/make-icon.mjs",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "node scripts/build-linux.mjs",
    "screenshots": "node scripts/make-screenshots.mjs",
    "perf": "electron . --dev --perf",
    "verify:dist": "node scripts/check-artifacts.mjs"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.paintmac.app",
    "productName": "Paint.mac",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "darkModeSupport": true,
      "icon": "build/icon.icns"
    },
    "copyright": "\u00a9 2026 Al Roland",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Paint.mac",
      "artifactName": "${productName}-${version}-Setup-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Graphics",
      "synopsis": "Paint.NET-style raster image editor",
      "description": "A fast layered raster image editor with selections, adjustments and effects.",
      "maintainer": "Al Roland <noreply@alroland.com>",
      "desktop": {
        "entry": {
          "Categories": "Graphics;2DGraphics;RasterGraphics;"
        }
      },
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "fileAssociations": [
      {
        "ext": "pmac",
        "name": "Paint.mac Document",
        "description": "Layered Paint.mac image",
        "role": "Editor",
        "icon": "build/icon.icns"
      }
    ],
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "afterPack": "scripts/adhoc-sign.js"
  },
  "homepage": "https://www.alroland.com/paint.mac"
}
